# OLIMA AI backend — prod muhit o'zgaruvchilari (namuna).
# Serverda: cp .env.example .env  va to'ldiring. .env git'ga tushmaydi.
# Barcha sozlamalar: olima-backend/src/main/resources/application.yml

DB_USERNAME=olima
DB_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (aynan 32 bayt — bazadagi tokenlar shu bilan shifrlanadi)
ENCRYPTION_KEY=

SUPER_ADMIN_USERNAME=super
SUPER_ADMIN_PASSWORD=

PUBLIC_BASE_URL=https://olima.example.uz
CORS_ORIGINS=https://olima.example.uz

# Yangi Telegram bot qaysi rejimda ulanadi: WEBHOOK yoki LONG_POLLING.
# SUPER_ADMIN panelda har bot uchun alohida tanlay oladi.
TELEGRAM_DEFAULT_UPDATE_MODE=LONG_POLLING

TAVILY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
