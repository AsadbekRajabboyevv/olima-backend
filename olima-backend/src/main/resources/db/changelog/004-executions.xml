<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-tool-executions" author="olima">
        <createTable tableName="tool_executions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="conversation_id" type="UUID"/>
            <column name="tool_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="tool_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="input" type="JSONB"/>
            <column name="output" type="JSONB"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="duration_ms" type="BIGINT"/>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="tool_executions" baseColumnNames="organization_id"
                                 referencedTableName="organizations" referencedColumnNames="id"
                                 constraintName="fk_tool_executions_organization"/>

        <addForeignKeyConstraint baseTableName="tool_executions" baseColumnNames="tool_id"
                                 referencedTableName="tools" referencedColumnNames="id"
                                 constraintName="fk_tool_executions_tool"/>

        <createIndex tableName="tool_executions" indexName="idx_tool_executions_organization_id">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="tool_executions" indexName="idx_tool_executions_conversation_id">
            <column name="conversation_id"/>
        </createIndex>
        <createIndex tableName="tool_executions" indexName="idx_tool_executions_tool_id">
            <column name="tool_id"/>
        </createIndex>
        <createIndex tableName="tool_executions" indexName="idx_tool_executions_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
