<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="020-create-token-rates" author="olima">
        <createTable tableName="token_rates">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="UUID">
                <constraints unique="true" uniqueConstraintName="uk_token_rates_organization"/>
            </column>
            <column name="input_price_per_million" type="NUMERIC(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="output_price_per_million" type="NUMERIC(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="token_rates" baseColumnNames="organization_id"
                                 referencedTableName="organizations" referencedColumnNames="id"
                                 constraintName="fk_token_rates_organization" onDelete="CASCADE"/>
        <sql>
            CREATE UNIQUE INDEX uk_token_rates_default ON token_rates ((organization_id IS NULL))
            WHERE organization_id IS NULL;
        </sql>
        <insert tableName="token_rates">
            <column name="id" value="00000000-0000-0000-0000-000000000001"/>
            <column name="input_price_per_million" valueNumeric="20000"/>
            <column name="output_price_per_million" valueNumeric="80000"/>
            <column name="updated_by" value="system"/>
        </insert>
    </changeSet>

    <changeSet id="020-llm-usage-cost" author="olima">
        <addColumn tableName="llm_usage">
            <column name="cost_uzs" type="NUMERIC(18,4)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            UPDATE llm_usage u
            SET cost_uzs = (u.prompt_tokens * r.input_price_per_million
                            + u.completion_tokens * r.output_price_per_million) / 1000000
            FROM token_rates r
            WHERE r.organization_id IS NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
